{
  "expo": {
    "name": "Nuvix+",
    "slug": "nuvixAPP",
    "scheme": "Nuvix",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.nuvix.client",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.riley_faze.nuvixAPP"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "display": "standalone",
      "themeColor": "#000000",
      "backgroundColor": "#000000",
      "orientation": "default", 
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "3724cb6e-5313-42b8-b807-8c0cf56c1441"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
